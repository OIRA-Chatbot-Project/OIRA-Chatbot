# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Model Configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.5
EMBEDDING_MODEL=text-embedding-3-large

# Clerk Authentication Configuration
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Database Configuration
DATABASE_URL=sqlite:///./chatbot.db

# Vector Store Configuration
CHROMA_PATH=chroma_db
CHROMA_COLLECTION_NAME=example_collection
DATA_PATH=data

# RAG Configuration
NUM_RETRIEVAL_RESULTS=5
CHUNK_SIZE=300
CHUNK_OVERLAP=100
# Enable multi-step query decomposition for complex questions (true/false)
# Helps with comparisons, multi-part questions, and conditional queries
USE_MULTI_STEP_QUERY=true

# Retriever Configuration
# Number of documents to retrieve per query
RETRIEVER_K=8
# Candidate pool size for MMR (Maximal Marginal Relevance)
RETRIEVER_FETCH_K=50
# MMR diversity parameter: 0=more diverse, 1=more similar
RETRIEVER_LAMBDA_MULT=0.4
# Maximum documents for multi-step queries (supports 2-5 sub-questions)
MAX_MULTI_STEP_DOCS=20
# Minimum documents guaranteed per sub-question (prevents starvation)
MIN_DOCS_PER_SUBQUERY=3

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PDF Base URL for document citations
PDF_BASE_URL=http://localhost:3000
